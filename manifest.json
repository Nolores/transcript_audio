<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediaTranscribe Pro</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#09090b">
    <!-- Załadowanie niezbędnych bibliotek -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #09090b; color: #f4f4f5; margin: 0; }
        .scrollbar-thin::-webkit-scrollbar { width: 6px; }
        .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
        .scrollbar-thin::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 10px; }
        select option { color: white !important; background-color: #18181b !important; padding: 12px; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // Komponent ikon SVG zabezpieczony przed błędami JSX
        const Icon = ({ name, size = 20, className = "" }) => {
            const icons = {
                Files: <path d="M20 7h-3a2 2 0 0 1-2-2V2M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h5l5 5v11a2 2 0 0 1-2 2zM3 7.6v12.8A1.6 1.6 0 0 0 4.6 22h9.8" />,
                Upload: <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" />,
                Globe: (
                    <React.Fragment>
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 2a14.5 14.5 0 0 0 0 20M2 12h20" />
                    </React.Fragment>
                ),
                Download: <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />,
                Play: <polygon points="5 3 19 12 5 21 5 3" />,
                Pause: (
                    <React.Fragment>
                        <rect x="6" y="4" width="4" height="16" />
                        <rect x="14" y="4" width="4" height="16" />
                    </React.Fragment>
                ),
                Copy: (
                    <React.Fragment>
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </React.Fragment>
                ),
                Trash2: (
                    <React.Fragment>
                        <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        <path d="M10 11v6M14 11v6" />
                    </React.Fragment>
                ),
                ClipboardPaste: (
                    <React.Fragment>
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                    </React.Fragment>
                ),
                Settings: (
                    <React.Fragment>
                        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                        <circle cx="12" cy="12" r="3" />
                    </React.Fragment>
                ),
                AlertCircle: (
                    <React.Fragment>
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </React.Fragment>
                )
            };
            return (
                <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}>
                    {icons[name]}
                </svg>
            );
        };

        const App = () => {
          const [apiKey, setApiKey] = useState(() => localStorage.getItem("gemini_api_key") || "");
          const [filesData, setFilesData] = useState([]);
          const [inputUrl, setInputUrl] = useState('');
          const [sourceLanguage, setSourceLanguage] = useState('auto');
          const [targetLanguage, setTargetLanguage] = useState('pl');
          const [translationMode, setTranslationMode] = useState('advanced'); 
          const [status, setStatus] = useState('idle');
          const [result, setResult] = useState(null);
          const [errorMessage, setErrorMessage] = useState('');
          const [currentFileIndex, setCurrentFileIndex] = useState(0);
          const [playingUrl, setPlayingUrl] = useState(null);
          const [isDragging, setIsDragging] = useState(false);
          const audioRef = useRef(new Audio());
          const fileInputRef = useRef(null);

          useEffect(() => {
            localStorage.setItem("gemini_api_key", apiKey);
          }, [apiKey]);

          useEffect(() => {
            return () => filesData.forEach(item => URL.revokeObjectURL(item.url));
          }, [filesData]);

          const resetForm = () => {
            filesData.forEach(item => URL.revokeObjectURL(item.url));
            setFilesData([]);
            setInputUrl('');
            setResult(null);
            setStatus('idle');
            setErrorMessage('');
            setCurrentFileIndex(0);
            audioRef.current.pause();
            setPlayingUrl(null);
          };

          const processFiles = (selectedFiles) => {
            const validFiles = Array.from(selectedFiles).filter(f => f.size <= 25 * 1024 * 1024);
            if (validFiles.length < Array.from(selectedFiles).length) setErrorMessage("Pominięto pliki powyżej 25MB.");
            const newFilesData = validFiles.map(file => ({ file, name: file.name, url: URL.createObjectURL(file) }));
            setFilesData(prev => [...prev, ...newFilesData]);
            setInputUrl('');
            setResult(null);
          };

          const toggleAudio = (url) => {
            if (playingUrl === url) { audioRef.current.pause(); setPlayingUrl(null); }
            else { audioRef.current.src = url; audioRef.current.play(); setPlayingUrl(url); }
          };

          const callGemini = async (base64, mime, id, tgt, isUrl) => {
            if (!apiKey) throw new Error("Musisz wpisać klucz API!");
            let prompt = `Zadanie: Dokładna transkrypcja i tłumaczenie. RYGORYSTYCZNE ZASADY: 1. W obu oknach używaj formatu: **[Rozmówca X]** w osobnej linii. 2. Tekst od nowej linii pod nazwą rozmówcy. 3. Każde zdanie od nowej linii. 4. Pusta linia odstępu przy zmianie rozmówcy. Tłumacz na polski.`;
            
            const parts = [{ text: prompt }];
            if (base64) parts.push({ inlineData: { mimeType: mime, data: base64 } });
            else if (isUrl) parts.push({ text: `Link: ${id}` });

            const payload = {
              contents: [{ parts }],
              generationConfig: { 
                responseMimeType: "application/json",
                responseSchema: {
                  type: "OBJECT",
                  properties: {
                    detectedLanguage: { type: "STRING" },
                    originalTranscription: { type: "STRING" },
                    translationLiteral: { type: "STRING" },
                    translationAdvanced: { type: "STRING" }
                  },
                  required: ["detectedLanguage", "originalTranscription", "translationLiteral", "translationAdvanced"]
                }
              },
              ...(isUrl && { tools: [{ "google_search": {} }] })
            };

            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await response.json();
            if (data.error) throw new Error(data.error.message);
            return JSON.parse(data.candidates[0].content.parts[0].text);
          };

          const startProcessing = async () => {
            if (!apiKey || apiKey.trim() === "") {
              setErrorMessage("BŁĄD: Musisz wkleić klucz API Gemini, aby rozpocząć.");
              setStatus('error');
              return;
            }
            setStatus('processing');
            setErrorMessage('');
            let combined = { detectedLanguage: "", originalTranscription: "", translationLiteral: "", translationAdvanced: "" };
            try {
              if (filesData.length) {
                for (let i = 0; i < filesData.length; i++) {
                  setCurrentFileIndex(i + 1);
                  const fD = filesData[i];
                  const r = new FileReader();
                  const b64 = await new Promise((res) => { r.onload = () => res(r.result.split(',')[1]); r.readAsDataURL(fD.file); });
                  const data = await callGemini(b64, fD.file.type || "audio/mpeg", fD.name, targetLanguage, false);
                  if (!combined.detectedLanguage) combined.detectedLanguage = data.detectedLanguage;
                  const header = `FILE_TAG:${fD.name}|${fD.url}\n\n`;
                  combined.originalTranscription += header + data.originalTranscription + "\n\n---\n\n";
                  combined.translationLiteral += header + data.translationLiteral + "\n\n---\n\n";
                  combined.translationAdvanced += header + data.translationAdvanced + "\n\n---\n\n";
                }
              } else if (inputUrl) {
                const data = await callGemini(null, null, inputUrl, targetLanguage, true);
                combined.detectedLanguage = data.detectedLanguage;
                combined.originalTranscription = `FILE_TAG:${inputUrl}|null\n\n` + data.originalTranscription;
                combined.translationLiteral = data.translationLiteral;
                combined.translationAdvanced = data.translationAdvanced;
              }
              setResult(combined);
              setStatus('success');
            } catch (err) { setErrorMessage(err.message); setStatus('error'); }
          };

          const renderText = (txt, isSource) => {
            if (!txt) return null;
            return txt.split('\n').map((line, i) => {
              const trimmed = line.trim();
              if (trimmed.startsWith('FILE_TAG:')) {
                const [tag, url] = trimmed.replace('FILE_TAG:', '').split('|');
                return (
                  <div key={i} className="mt-8 mb-4 border-b border-blue-500/20 pb-2 flex items-center justify-between">
                    <span className="text-[14px] font-black text-blue-500 uppercase tracking-widest flex items-center gap-2"><Icon name="Files" size={16}/> {tag}</span>
                    {isSource && url !== 'null' && (
                      <button onClick={() => toggleAudio(url)} className="px-3 py-1 bg-blue-500/10 text-blue-500 text-[10px] font-black uppercase rounded-lg border border-blue-500/20">{playingUrl === url ? "Stop" : "Play"}</button>
                    )}
                  </div>
                );
              }
              if (trimmed.startsWith('**') && trimmed.endsWith('**')) return <div key={i} className="font-bold text-zinc-500 mt-6 mb-1 text-[13px] uppercase tracking-widest">{trimmed.replace(/\*\*/g, '')}</div>;
              if (trimmed === '---') return <div key={i} className="my-10 h-px bg-zinc-800 opacity-20" />;
              return <div key={i} className="min-h-[1.5em]">{trimmed}</div>;
            });
          };

          return (
            <div className="min-h-screen bg-zinc-950 p-4 lg:p-10">
              <header className="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center mb-10 gap-6">
                <div className="flex items-center gap-4">
                  <div className="p-4 rounded-2xl bg-indigo-600 shadow-xl"><Icon name="Files" size={32} /></div>
                  <div><h1 className="text-3xl font-black uppercase tracking-tighter text-white">MediaTranscribe Pro</h1><p className="text-[10px] uppercase tracking-widest opacity-40">v6.7 Final • Szef Edition</p></div>
                </div>
                <button onClick={resetForm} className="px-8 py-4 rounded-2xl font-black text-xs uppercase border border-zinc-800 hover:text-rose-400 transition-all text-zinc-400"><Icon name="Trash2" size={16} className="inline mr-2" /> Wyczyść sesję</button>
              </header>

              <div className="max-w-7xl mx-auto grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
                <div className={`xl:col-span-4 space-y-6 ${(status === 'idle' && !result) ? 'xl:col-start-5 xl:col-span-4' : ''} transition-all duration-700`}>
                  <div className="p-10 rounded-[3rem] border border-zinc-800 bg-zinc-900 shadow-2xl">
                    <div className="space-y-8">
                      <div className="space-y-3">
                        <label className="text-[10px] font-black uppercase opacity-60 ml-1 tracking-widest flex items-center gap-2 text-zinc-400"><Icon name="Settings" size={12}/> Klucz API Gemini</label>
                        <input type="password" placeholder="Wklej klucz API" value={apiKey} onChange={(e) => setApiKey(e.target.value)} className="w-full p-4 rounded-xl bg-zinc-800/50 border border-zinc-800 outline-none focus:border-indigo-500 text-white text-xs font-bold transition-all" />
                      </div>

                      <div 
                        onDragOver={(e) => {e.preventDefault(); setIsDragging(true);}}
                        onDragLeave={() => setIsDragging(false)}
                        onDrop={(e) => {e.preventDefault(); setIsDragging(false); processFiles(e.dataTransfer.files);}}
                        onClick={() => fileInputRef.current.click()} 
                        className={`border-2 border-dashed rounded-[2.5rem] p-12 text-center cursor-pointer transition-all ${isDragging ? 'border-blue-500 bg-blue-500/10' : 'border-zinc-800 hover:border-indigo-500'}`}
                      >
                        <input type="file" ref={fileInputRef} className="hidden" multiple onChange={(e) => processFiles(e.target.files)} />
                        <Icon name="Upload" className="mx-auto mb-4 opacity-20" size={56} />
                        <p className="text-[13px] font-black uppercase tracking-widest">{filesData.length ? `Dodano ${filesData.length} plików` : "Wgraj lub przeciągnij media"}</p>
                      </div>

                      <input type="text" placeholder="YouTube Link..." value={inputUrl} onChange={(e) => setInputUrl(e.target.value)} className="w-full p-4 rounded-xl bg-transparent border border-zinc-800 outline-none focus:border-indigo-500 text-white font-bold text-sm" />
                      
                      <div className="grid grid-cols-2 gap-4">
                        <div className="space-y-2">
                          <label className="text-[12px] font-black uppercase text-blue-500 ml-1 tracking-widest block">Język źródła</label>
                          <select className="w-full p-4 rounded-xl bg-zinc-800 border-none text-white text-[13px] font-black outline-none"><option>Auto-wykrywanie</option></select>
                        </div>
                        <div className="space-y-2">
                          <label className="text-[12px] font-black uppercase text-blue-500 ml-1 tracking-widest block">Tłumaczenie</label>
                          <select className="w-full p-4 rounded-xl bg-zinc-800 border-none text-white text-[13px] font-black outline-none"><option>Polski (POL)</option></select>
                        </div>
                      </div>

                      <button onClick={startProcessing} disabled={status === 'processing'} className="w-full py-6 rounded-[2.5rem] bg-indigo-600 text-white font-black text-sm uppercase tracking-[0.4em] shadow-2xl active:scale-95 transition-all">
                        {status === 'processing' ? `Analizuję...` : "Rozpocznij"}
                      </button>
                    </div>
                  </div>
                  {status === 'error' && <div className="p-6 bg-rose-500/10 border border-rose-500/20 rounded-[2rem] text-rose-500 text-[13px] font-black flex gap-3"><Icon name="AlertCircle" size={20}/> {errorMessage}</div>}
                </div>

                {(status === 'processing' || result) && (
                  <div className="xl:col-span-8 grid grid-cols-1 lg:grid-cols-2 gap-8 animate-in fade-in duration-700">
                    <div className="flex flex-col h-[42rem] rounded-[3rem] border border-zinc-800 bg-zinc-900 overflow-hidden shadow-2xl">
                      <div className="p-8 border-b border-zinc-800 flex items-center justify-between"><h3 className="text-sm font-black uppercase text-blue-500">Źródło</h3><button onClick={() => result && navigator.clipboard.writeText(result.originalTranscription)} className="text-zinc-500 hover:text-blue-500"><Icon name="Copy" size={20}/></button></div>
                      <div className="flex-1 overflow-y-auto p-8 bg-black/40 scrollbar-thin">{renderText(result?.originalTranscription, true)}</div>
                    </div>
                    <div className="flex flex-col h-[42rem] rounded-[3rem] border border-zinc-800 bg-zinc-900 overflow-hidden shadow-2xl">
                      <div className="p-8 border-b border-zinc-800 flex flex-col justify-center">
                        <div className="flex items-center justify-between mb-4">
                          <h3 className="text-sm font-black uppercase text-blue-500">Tłumaczenie (POL)</h3>
                          <button onClick={() => result && navigator.clipboard.writeText(translationMode === 'advanced' ? result.translationAdvanced : result.translationLiteral)} className="text-zinc-500 hover:text-blue-500"><Icon name="Copy" size={20}/></button>
                        </div>
                        <div className="flex gap-2 p-1 rounded-xl bg-zinc-800/40 w-fit">
                          <button onClick={() => setTranslationMode('literal')} className={`px-4 py-2 text-[9px] font-black uppercase rounded-lg ${translationMode === 'literal' ? 'bg-indigo-600 text-white' : 'text-zinc-500'}`}>Dosłowne</button>
                          <button onClick={() => setTranslationMode('advanced')} className={`px-4 py-2 text-[9px] font-black uppercase rounded-lg ${translationMode === 'advanced' ? 'bg-indigo-600 text-white' : 'text-zinc-500'}`}>Zaawansowane</button>
                        </div>
                      </div>
                      <div className="flex-1 overflow-y-auto p-8 bg-black/40 scrollbar-thin">{renderText(translationMode === 'advanced' ? result?.translationAdvanced : result?.translationLiteral, false)}</div>
                    </div>
                  </div>
                )}
              </div>
              <footer className="mt-20 pt-12 border-t border-zinc-900/50 opacity-30 text-center text-zinc-400 font-bold uppercase text-[10px] tracking-[0.4em]">Aplikacja utworzona przez Szefa (nolores123@gmail.com)</footer>
            </div>
          );
        };
        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
